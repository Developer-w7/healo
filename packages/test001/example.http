# @name sendotp
POST http://127.0.0.1:5000/user/sendotp HTTP/1.1
content-type: application/json

{
"email":{{email}},
"password":{{pass}}
}

###
@authOTP = {{sendotp.response.body.$.otp}}

###
POST http://127.0.0.1:5000/user/login_with_otp HTTP/1.1
content-type: application/json

{
"email":{{email}},
"otp":"{{authOTP}}"
}

###
